# Copy this file to .env and fill in only what you use:
#   cp .env.example .env
# .env is git-ignored. Keep real keys there: never in generate.py, a recipe, or a commit.
# Format: KEY=value, one per line.

# Provider generate.py uses (--provider overrides it).
# "placeholder" is the offline test provider: test-pattern clips, no key needed.
VIDEO_PROVIDER=placeholder

# API keys for candidate providers. These are placeholders: only the key of the
# provider that gets wired up is read, so the others can stay as they are.
FAL_KEY=your-fal-api-key
RUNWAYML_API_SECRET=your-runway-api-key
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
REPLICATE_API_TOKEN=your-replicate-api-token

# Optional: bold .ttf/.otf for the on-screen text. Leave empty to use a system bold font.
FONT_FILE=
