# Copy this file to .env and fill it in:
#   cp .env.example .env
# .env is git-ignored. Keep real keys there: never in generate.py, a recipe, or a commit.
# Format: KEY=value, one per line.

# Provider generate.py uses (--provider overrides it):
#   render       local 3D animation, no key, no cost (needs Node.js; see README)
#   blender      Blender/Cycles 3D film, no key, no cost, slow on CPU (needs Blender; see README)
#   fal          generative AI video through fal.ai (needs FAL_KEY)
#   placeholder  offline test: test-pattern clips
VIDEO_PROVIDER=render

# Optional for render: parallel browser processes per clip (helps only on many-core machines).
# RENDER_WORKERS=1

# Optional for blender: a Python that can `import bpy` (if it isn't the one running generate.py),
# render size in percent of 1080x1920, and Cycles samples (denoised).
# BLENDER_PYTHON=
# BLENDER_SCALE=75
# BLENDER_SAMPLES=12

# fal.ai API key, only for --provider fal: create one at https://fal.ai/dashboard/keys
FAL_KEY=your-fal-api-key

# Optional fal model overrides (these are the defaults):
# FAL_IMAGE_MODEL=fal-ai/flux-pro/v1.1-ultra
# FAL_VIDEO_MODEL=fal-ai/vidu/q2/reference-to-video
# Optional extra JSON fields for every image/video request:
# FAL_VIDEO_ARGS={"resolution": "1080p"}
# FAL_IMAGE_ARGS=

# Optional: bold .ttf/.otf for the on-screen text. Leave empty to use a system bold font.
FONT_FILE=
